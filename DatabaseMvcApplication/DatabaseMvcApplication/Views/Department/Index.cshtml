@model List<Department>


@if (TempData["Error"] !=null)
{
	<div class="alert alert-danger">
		@TempData["Error"].ToString();
	</div>
}

@if (TempData["Success"] != null)
{
	<div class="alert alert-success">
		@TempData["Success"].ToString();
	</div>
}


<div class="row">
	<div class="col-6"><h4>Department List</h4></div>
	<div class="col-6">
		<a class="btn btn-primary" asp-controller="Department" asp-action="Create"> Create Department</a>
	</div>
	
</div>

<table class="table table-bordered">

	<tr>
		<th>Ref</th>
		<th>Name</th>
		<th>Actions</th>
	</tr>

	@foreach(var dept in Model)
	{
		<tr>

			<td>@dept.Id</td>
			<td>@dept.Title</td>
			<td>
				<a class="btn btn-info" asp-controller="Department10. What is TempData used for?
				a) Passing data within same request
				b) Passing data between requests (short-term)
				c) Permanent storage
				d) Database storage
				" asp-action="Edit" asp-route-did="@dept.Id">Edit</a>
				<a class="btn btn-danger" asp-controller="Department" asp-action="Delete" asp-route-did="@dept.Id">Delete</a>

			</td>

		</tr>
	}
</table>
